// Copied temporarily into upstream e2e/tests/plugins by run_host_tests.py.
// Uses upstream's isolated, disposable browser context and real plugin upload UI.
import { expect, test } from '../../fixtures/test.fixture';
import { waitForPluginManagementInit } from '../../helpers/plugin-test.helpers';
import { fillMarkdownEditor } from '../../utils/markdown-editor';
import path from 'node:path';

const installPopup = async (page: import('@playwright/test').Page): Promise<void> => {
  if (process.env.POPUP_BASELINE === '1') return;
  await installZip(page, process.env.POPUP_PLUGIN_ZIP!, 'Task Details Popup');
};

const installZip = async (
  page: import('@playwright/test').Page,
  zip: string,
  name: string,
): Promise<void> => {
  await page.goto('/#/config');
  await waitForPluginManagementInit(page);
  await page.locator('plugin-management input[type="file"]').setInputFiles(zip);
  const consent = page.locator('dialog-confirm');
  const plugin = page
    .locator('plugin-management mat-card')
    .filter({ has: page.locator('mat-card-title', { hasText: name }) });
  // v19.1 installs directly; newer hosts require an explicit consent dialog.
  await expect(consent.or(plugin).first()).toBeVisible();
  if (await consent.isVisible())
    await consent.getByRole('button', { name: /Confirm|Install/i }).click();
  await expect(plugin).toBeVisible();
  const toggle = plugin.getByRole('switch');
  if (!(await toggle.isChecked())) await toggle.click();
  await expect(toggle).toBeChecked();
  await page.goto('/#/tag/TODAY/tasks');
};

test('opening appears centred without reserving sidebar width', async ({
  page,
  workViewPage,
  taskPage,
}) => {
  await page.setViewportSize({ width: 1280, height: 900 });
  await installPopup(page);
  await workViewPage.waitForTaskList();
  await workViewPage.addTask('No sidebar entrance animation');
  await taskPage.getTaskByText('No sidebar entrance animation').hover();
  const toggle = page.getByRole('button', { name: 'Show/hide task panel' });
  const samples = await toggle.evaluate(async (button) => {
    const header = document.querySelector('main-header')!;
    const originalWidth = header.getBoundingClientRect().width;
    const frames: { visible: boolean; centre: number; headerWidth: number }[] = [];
    (button as HTMLButtonElement).click();
    for (let n = 0; n < 30; n++) {
      await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
      const side = document.querySelector('right-panel > .side');
      const rect = side?.getBoundingClientRect();
      const style = side && getComputedStyle(side);
      const halfWidth = rect ? rect.width / 2 : 0;
      const visible =
        !!rect &&
        rect.width > 1 &&
        style?.display !== 'none' &&
        style?.visibility !== 'hidden' &&
        Number(style?.opacity) > 0;
      frames.push({
        visible,
        centre: rect ? rect.x + halfWidth : 0,
        headerWidth: header.getBoundingClientRect().width,
      });
    }
    return { frames, originalWidth };
  });
  for (const frame of samples.frames) {
    expect(Math.abs(frame.headerWidth - samples.originalWidth)).toBeLessThan(2);
    if (frame.visible) expect(Math.abs(frame.centre - 640)).toBeLessThan(2);
  }
  await expect(page.locator('[data-task-popup-dialog]')).toBeVisible();
});

test('rapid reopen does not revive an outgoing sidebar', async ({
  page,
  workViewPage,
  taskPage,
}) => {
  await page.setViewportSize({ width: 1280, height: 900 });
  await installPopup(page);
  await workViewPage.waitForTaskList();
  await workViewPage.addTask('Reopen popup task');
  const task = taskPage.getTaskByText('Reopen popup task');
  await taskPage.openTaskDetail(task);
  await page.locator('[data-task-popup-close]').click();
  await expect(page.locator('[data-task-popup-dialog]')).toHaveCount(0);
  await taskPage.openTaskDetail(task);
  await expect(page.locator('[data-task-popup-dialog]')).toHaveCount(1);
  await expect(page.locator('[data-task-popup-close]')).toHaveCount(1);
  await expect(page.locator('[data-task-popup-backdrop]')).toHaveCount(1);
  await expect(page.locator('right-panel > .side')).toHaveCount(1);
  await page.locator('[data-task-popup-close]').click();
  await expect(
    page.locator('[data-task-popup-retiring],right-panel > .side'),
  ).toHaveCount(0);
});

test('native subtask creation remains usable in the stacked editor', async ({
  page,
  workViewPage,
  taskPage,
}) => {
  await page.setViewportSize({ width: 1280, height: 900 });
  await installPopup(page);
  await workViewPage.waitForTaskList();
  await workViewPage.addTask('Subtask popup parent');
  const parent = taskPage.getTaskByText('Subtask popup parent');
  const parentId = await parent.getAttribute('data-task-id');
  await taskPage.openTaskDetail(parent);
  const popup = page.locator(
    process.env.POPUP_BASELINE === '1'
      ? 'right-panel > .side'
      : '[data-task-popup-dialog]',
  );
  const subtasks = popup
    .locator('task-detail-item')
    .filter({ has: page.locator('.panel-header-icon') });
  const add = subtasks.getByRole('button', { name: /Add sub.?task/i });
  if (!(await add.isVisible()))
    await subtasks.locator('mat-expansion-panel-header').click();
  await add.click();
  const draft = popup.locator('.e2e-add-subtask-input');
  await draft.fill('Native popup subtask');
  await draft.press('Enter');
  await expect(
    popup.locator('task').filter({ hasText: 'Native popup subtask' }),
  ).toBeVisible();
  // Do not exercise the host's separate add-draft Escape bug here: its
  // addSubTaskBtn()?.nativeElement.focus() throws even without this plugin.
  if (process.env.POPUP_BASELINE === '1') {
    await popup
      .locator('.edge-close-handle')
      .dispatchEvent('keydown', { key: 'Enter', code: 'Enter' });
  } else {
    await popup.locator('[data-task-popup-close]').click();
  }
  await expect(popup).toHaveCount(0);
  await expect(page.locator('right-panel > .side')).toHaveCount(0);
  const parentRow = page.locator(`task[data-task-id="${parentId}"]`);
  await parentRow.locator('.title-and-tags-wrapper').first().hover();
  await parentRow.locator('button.show-additional-info-btn').first().click();
  await expect(popup.locator('task-detail-panel')).toBeVisible();
  const subtaskHeader = subtasks.locator('mat-expansion-panel-header');
  if ((await subtaskHeader.getAttribute('aria-expanded')) !== 'true') {
    await subtaskHeader.click();
  }
  await expect(
    popup.locator('task').filter({ hasText: 'Native popup subtask' }),
  ).toBeVisible();
});

test('closing never reveals a shrinking sidebar or narrows the page', async ({
  page,
  workViewPage,
  taskPage,
}) => {
  await page.setViewportSize({ width: 1280, height: 900 });
  await installPopup(page);
  await workViewPage.waitForTaskList();
  await workViewPage.addTask('No sidebar exit animation');
  await taskPage.openTaskDetail(taskPage.getTaskByText('No sidebar exit animation'));
  await expect(page.locator('[data-task-popup-dialog]')).toBeVisible();
  const samples = await page.evaluate(async () => {
    const side = document.querySelector('[data-task-popup-dialog]') as HTMLElement;
    const header = document.querySelector('main-header')!;
    const original = side.getBoundingClientRect();
    const headerWidth = header.getBoundingClientRect().width;
    const frames: {
      sideVisible: boolean;
      x: number;
      width: number;
      headerWidth: number;
    }[] = [];
    (side.querySelector('[data-task-popup-close]') as HTMLButtonElement).click();
    for (let n = 0; n < 30; n++) {
      await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
      const rect = side.getBoundingClientRect();
      const style = getComputedStyle(side);
      const sideVisible =
        side.isConnected &&
        style.display !== 'none' &&
        style.visibility !== 'hidden' &&
        Number(style.opacity) > 0 &&
        rect.width > 1;
      frames.push({
        sideVisible,
        x: rect.x,
        width: rect.width,
        headerWidth: header.getBoundingClientRect().width,
      });
    }
    return { frames, original: { x: original.x, width: original.width }, headerWidth };
  });
  for (const frame of samples.frames) {
    expect(
      Math.abs(frame.headerWidth - samples.headerWidth),
      'Closing reserved sidebar width',
    ).toBeLessThan(2);
    if (frame.sideVisible) {
      expect(
        Math.abs(frame.x - samples.original.x),
        'Closing slid the popup to the right',
      ).toBeLessThan(2);
      expect(
        Math.abs(frame.width - samples.original.width),
        'Closing shrank the native sidebar',
      ).toBeLessThan(2);
    }
  }
  await expect(page.locator('right-panel > .side')).toHaveCount(0);
});

test('desktop retains the native stacked field layout', async ({
  page,
  workViewPage,
  taskPage,
}) => {
  await page.setViewportSize({ width: 1280, height: 900 });
  await installPopup(page);
  await workViewPage.waitForTaskList();
  await workViewPage.addTask('Refined popup layout');
  await taskPage.openTaskDetail(taskPage.getTaskByText('Refined popup layout'));
  const popup = page.locator('[data-task-popup-dialog]');
  const notes = popup
    .locator('task-detail-item')
    .filter({ has: page.locator('inline-markdown') });
  const schedule = popup
    .locator('task-detail-item')
    .filter({ hasText: /Planned for|Schedule Task/ })
    .first();
  const mainBounds = await notes.boundingBox();
  const metadataBounds = await schedule.boundingBox();
  expect(Math.abs(metadataBounds!.x - mainBounds!.x)).toBeLessThan(1);
  expect(Math.abs(metadataBounds!.width - mainBounds!.width)).toBeLessThan(1);
  // Keep the native DOM order rather than visually reordering Angular fields.
  expect(metadataBounds!.y + metadataBounds!.height).toBeLessThanOrEqual(mainBounds!.y);
});

for (const appearance of ['light', 'dark', 'todoist'] as const) {
  test(`title has a complete stable frame at rest and during editing, ${appearance}`, async ({
    page,
    workViewPage,
    taskPage,
  }) => {
    await page.setViewportSize({ width: 1280, height: 900 });
    await page.emulateMedia({ colorScheme: appearance === 'light' ? 'light' : 'dark' });
    await installPopup(page);
    if (appearance === 'todoist')
      await page.addStyleTag({ path: process.env.POPUP_TODOIST_THEME_CSS! });
    await workViewPage.waitForTaskList();
    await workViewPage.addTask('Title frame regression');
    await taskPage.openTaskDetail(taskPage.getTaskByText('Title frame regression'));
    const popup = page.locator('[data-task-popup-dialog]');
    const frame = popup.locator('.task-title-wrapper');
    const notesCard = popup
      .locator('task-detail-item')
      .filter({ has: page.locator('inline-markdown') })
      .locator('mat-expansion-panel');
    const restingColour = await notesCard.evaluate(
      (el) => getComputedStyle(el).borderTopColor,
    );
    for (const edge of ['top', 'right', 'bottom', 'left']) {
      await expect(frame).toHaveCSS(`border-${edge}-width`, '1px');
      await expect(frame).toHaveCSS(`border-${edge}-color`, restingColour);
    }
    const before = await frame.boundingBox();
    await frame.locator('task-title').click();
    const editor = frame.locator('textarea');
    await expect(editor).toBeFocused();
    const focusColour = await frame.evaluate((el) => {
      const probe = document.createElement('span');
      probe.style.color = 'var(--palette-primary-400, var(--c-primary))';
      el.append(probe);
      try {
        return getComputedStyle(probe).color;
      } finally {
        probe.remove();
      }
    });
    for (const edge of ['top', 'right', 'bottom', 'left']) {
      await expect(frame).toHaveCSS(`border-${edge}-width`, '1px');
      await expect(frame).toHaveCSS(`border-${edge}-color`, focusColour);
    }
    const editing = await frame.boundingBox();
    expect(editing!.x).toBe(before!.x);
    expect(editing!.width).toBe(before!.width);
    // The outer frame owns the highlight; the native inline editor must not
    // draw an inset second frame/elevation inside it.
    const titleHost = frame.locator('task-title');
    for (const edge of ['top', 'right', 'bottom', 'left']) {
      await expect(titleHost).toHaveCSS(`border-${edge}-color`, 'rgba(0, 0, 0, 0)');
    }
    await expect(titleHost).toHaveCSS('box-shadow', 'none');
    await expect(titleHost).toHaveCSS('outline-style', 'none');
    await expect(titleHost).toHaveCSS('background-color', 'rgba(0, 0, 0, 0)');
    await expect(editor).toHaveCSS('outline-style', 'none');
    if (process.env.POPUP_SCREENSHOT_DIR) {
      await page.screenshot({
        path: path.join(
          process.env.POPUP_SCREENSHOT_DIR,
          `popup-${process.env.POPUP_HOST_VERSION}-${appearance}-title.png`,
        ),
      });
    }
    await editor.fill('Title frame edit saved');
    await popup.locator('[data-task-popup-close]').focus();
    await expect(frame).toContainText('Title frame edit saved');
    for (const edge of ['top', 'right', 'bottom', 'left']) {
      await expect(frame).toHaveCSS(`border-${edge}-color`, restingColour);
    }
  });

  test(`native card and editor focus styling is preserved, ${appearance}`, async ({
    page,
    workViewPage,
    taskPage,
  }) => {
    await page.setViewportSize({ width: 1280, height: 900 });
    await page.emulateMedia({ colorScheme: appearance === 'light' ? 'light' : 'dark' });
    await installPopup(page);
    if (appearance === 'todoist') {
      await page.addStyleTag({ path: process.env.POPUP_TODOIST_THEME_CSS! });
      await expect(page.locator('body')).toHaveClass(/isDarkTheme/);
      await expect(page.locator('body')).toHaveCSS('--td-accent', '#e26a60');
    }
    await workViewPage.waitForTaskList();
    await workViewPage.addTask('Native focus borders');
    await taskPage.openTaskDetail(taskPage.getTaskByText('Native focus borders'));
    const popup = page.locator('[data-task-popup-dialog]');
    const notes = popup
      .locator('task-detail-item')
      .filter({ has: page.locator('inline-markdown') });
    const duration = popup
      .locator('task-detail-item')
      .filter({ hasText: 'Duration' })
      .first();
    for (const item of [duration, notes]) {
      await page.keyboard.press('Tab');
      await item.focus();
      const comparison = await item.evaluate((el) => {
        const sheet = (
          document.querySelector('[data-task-popup-style]') as HTMLStyleElement
        ).sheet!;
        const card = el.querySelector(
          ':scope > .input-item,:scope > mat-expansion-panel',
        )!;
        const properties = [
          'border-top-width',
          'border-right-width',
          'border-bottom-width',
          'border-left-width',
          'border-top-color',
          'border-right-color',
          'border-bottom-color',
          'border-left-color',
          'border-radius',
          'background-color',
          'outline-style',
          'outline-width',
          'outline-color',
        ];
        const read = (): Record<string, string>[] =>
          [el, card].map((node) => {
            const css = getComputedStyle(node);
            return Object.fromEntries(
              properties.map((key) => [key, css.getPropertyValue(key)]),
            );
          });
        const actual = read();
        sheet.disabled = true;
        try {
          return { actual, native: read() };
        } finally {
          sheet.disabled = false;
        }
      });
      expect(comparison.actual).toEqual(comparison.native);
      // The app's complete focus border must survive, not just a bottom line.
      for (const edge of ['top', 'right', 'bottom', 'left']) {
        expect(parseFloat(comparison.actual[1][`border-${edge}-width`])).toBeGreaterThan(
          0,
        );
      }
      const frame = await item.evaluate((el) => {
        const viewport = el.closest('.side-inner')!.getBoundingClientRect();
        const rect = el.getBoundingClientRect();
        const css = getComputedStyle(el);
        const ring =
          css.outlineStyle === 'none'
            ? 0
            : parseFloat(css.outlineWidth) + parseFloat(css.outlineOffset);
        return {
          left: rect.left - ring,
          right: rect.right + ring,
          clipLeft: viewport.left,
          clipRight: viewport.right,
        };
      });
      expect(frame.left).toBeGreaterThanOrEqual(frame.clipLeft);
      expect(frame.right).toBeLessThanOrEqual(frame.clipRight);
    }
    await fillMarkdownEditor(
      notes.locator('inline-markdown'),
      'Notes with an intact native focus frame',
    );
    const editorOutline = await notes.locator('inline-markdown').evaluate((el) => {
      const sheet = (
        document.querySelector('[data-task-popup-style]') as HTMLStyleElement
      ).sheet!;
      const read = (): string[] => {
        const css = getComputedStyle(el);
        return [css.outlineStyle, css.outlineWidth, css.outlineOffset];
      };
      const actual = read();
      sheet.disabled = true;
      try {
        return { actual, native: read() };
      } finally {
        sheet.disabled = false;
      }
    });
    expect(editorOutline.actual).toEqual(editorOutline.native);
    if (process.env.POPUP_SCREENSHOT_DIR) {
      await page.screenshot({
        path: path.join(
          process.env.POPUP_SCREENSHOT_DIR,
          `popup-${process.env.POPUP_HOST_VERSION}-${appearance}-focus.png`,
        ),
      });
    }
  });

  test(`metadata hover does not move values or resize fields, ${appearance}`, async ({
    page,
    workViewPage,
    taskPage,
  }) => {
    await page.setViewportSize({ width: 1280, height: 900 });
    await page.emulateMedia({ colorScheme: appearance === 'light' ? 'light' : 'dark' });
    await installPopup(page);
    if (appearance === 'todoist')
      await page.addStyleTag({ path: process.env.POPUP_TODOIST_THEME_CSS! });
    await workViewPage.waitForTaskList();
    await workViewPage.addTask('Stable metadata hover');
    await taskPage.openTaskDetail(taskPage.getTaskByText('Stable metadata hover'));
    const popup = page.locator('[data-task-popup-dialog]');
    const row = popup.locator('task-detail-item').filter({ hasText: 'Duration' }).first();
    await row.scrollIntoViewIfNeeded();
    await page.mouse.move(10, 10);
    const readGeometry = async (): Promise<number[]> =>
      row.evaluate((el) => {
        const side = el.closest('[data-task-popup-dialog]')!;
        const nodes = [
          side,
          side.querySelector('.side-inner')!,
          el,
          el.querySelector('.input-item__title')!,
          el.querySelector('.input-item__value')!,
        ];
        return nodes.flatMap((node) => {
          const rect = node.getBoundingClientRect();
          return [rect.x, rect.y, rect.width, rect.height];
        });
      });
    for (const width of [1280, 844, 600]) {
      await page.setViewportSize({ width, height: 900 });
      await row.scrollIntoViewIfNeeded();
      await page.mouse.move(10, 10);
      const insets = await row.locator(':scope > .input-item').evaluate((el) => {
        const outer = el.closest('[data-task-popup-dialog]')!.getBoundingClientRect();
        const card = el.getBoundingClientRect();
        return { left: card.left - outer.left, right: outer.right - card.right };
      });
      expect(
        Math.abs(insets.left - insets.right),
        'Asymmetric popup card insets',
      ).toBeLessThan(1);
      const before = await readGeometry();
      for (let repeat = 0; repeat < 3; repeat++) {
        await row.locator('.input-item').hover();
        const hovered = await readGeometry();
        expect(hovered.map((value, index) => Math.abs(value - before[index]))).toEqual(
          before.map(() => 0),
        );
        await expect(row.locator('.input-item__edit-btn')).toBeVisible();
        await page.mouse.move(10, 10);
        await expect(row.locator('.input-item__edit-btn')).not.toBeVisible();
        expect(await readGeometry()).toEqual(before);
      }
      const geometry = await popup.locator('.side-inner').evaluate((el) => ({
        client: el.clientWidth,
        scroll: el.scrollWidth,
      }));
      expect(geometry.scroll).toBeLessThanOrEqual(geometry.client);
    }
  });
}

test('popup fits short content and scrolls long content within the viewport', async ({
  page,
  workViewPage,
  taskPage,
}) => {
  await page.setViewportSize({ width: 1280, height: 1000 });
  await installPopup(page);
  await workViewPage.waitForTaskList();
  await workViewPage.addTask('Content-sized popup');
  await taskPage.openTaskDetail(taskPage.getTaskByText('Content-sized popup'));
  const popup = page.locator('[data-task-popup-dialog]');
  const notes = popup
    .locator('task-detail-item')
    .filter({ has: page.locator('inline-markdown') });
  const header = notes.locator('mat-expansion-panel-header');
  if ((await header.getAttribute('aria-expanded')) === 'true') await header.click();
  await expect(header).toHaveAttribute('aria-expanded', 'false');
  await expect
    .poll(() =>
      popup.evaluate((el) => {
        const created = el.querySelector('.date-info')!.getBoundingClientRect();
        return el.getBoundingClientRect().bottom - created.bottom;
      }),
    )
    .toBeLessThan(32);
  const shortHeight = (await popup.boundingBox())!.height;
  const scroll = popup.locator('.side-inner');
  expect(
    await scroll.evaluate((el) => el.scrollHeight - el.clientHeight),
  ).toBeLessThanOrEqual(1);

  await header.click();
  await fillMarkdownEditor(
    notes.locator('inline-markdown'),
    Array.from(
      { length: 40 },
      (_, index) => `Long note line ${index}: native editing stays scrollable.`,
    ).join('\n'),
  );
  await expect
    .poll(() => scroll.evaluate((el) => el.scrollHeight > el.clientHeight))
    .toBe(true);
  const expanded = (await popup.boundingBox())!;
  expect(expanded.height).toBeGreaterThan(shortHeight);
  expect(expanded.height).toBeLessThanOrEqual(761);
  const created = popup.locator('.date-info');
  await created.scrollIntoViewIfNeeded();
  const expandedFooter = (await created.boundingBox())!;
  expect(expandedFooter.y + expandedFooter.height).toBeLessThanOrEqual(
    expanded.y + expanded.height,
  );
  const scrollingInsets = await notes.locator('mat-expansion-panel').evaluate((el) => {
    const outer = el.closest('[data-task-popup-dialog]')!.getBoundingClientRect();
    const card = el.getBoundingClientRect();
    return { left: card.left - outer.left, right: outer.right - card.right };
  });
  expect(Math.abs(scrollingInsets.left - scrollingInsets.right)).toBeLessThan(1);
  await page.setViewportSize({ width: 844, height: 390 });
  await expect
    .poll(async () => {
      const box = (await popup.boundingBox())!;
      return box.y + box.height;
    })
    .toBeLessThanOrEqual(374);
  await expect(popup.locator('[data-task-popup-close]')).toBeInViewport();
  await created.scrollIntoViewIfNeeded();
  const narrow = (await popup.boundingBox())!;
  const footer = (await created.boundingBox())!;
  expect(footer.y + footer.height).toBeLessThanOrEqual(narrow.y + narrow.height);
  expect(
    await scroll.evaluate((el) => el.scrollWidth - el.clientWidth),
  ).toBeLessThanOrEqual(1);
});

test('backdrop commits a pending title and restores native task focus', async ({
  page,
  workViewPage,
  taskPage,
}) => {
  await page.setViewportSize({ width: 1280, height: 900 });
  await installPopup(page);
  await workViewPage.waitForTaskList();
  await workViewPage.addTask('Before title edit');
  await taskPage.openTaskDetail(taskPage.getTaskByText('Before title edit'));
  const title = page.locator('[data-task-popup-dialog] task-title');
  await title.click();
  await title.locator('textarea').fill('Saved through popup backdrop');
  await page.locator('[data-task-popup-backdrop]').click({ position: { x: 10, y: 10 } });
  await expect(page.locator('[data-task-popup-dialog]')).toHaveCount(0);
  const updated = page
    .locator('task')
    .filter({ hasText: 'Saved through popup backdrop' });
  await expect(updated).toBeVisible();
  await expect
    .poll(() =>
      updated.evaluate(
        (el) => el === document.activeElement || el.contains(document.activeElement),
      ),
    )
    .toBe(true);
  await page.reload();
  await expect(updated).toBeVisible();
});

test('first Escape leaves live notes editing, second dismisses and saves', async ({
  page,
  workViewPage,
  taskPage,
}) => {
  await page.setViewportSize({ width: 1280, height: 900 });
  await installPopup(page);
  await workViewPage.waitForTaskList();
  await workViewPage.addTask('Live notes popup');
  const task = taskPage.getTaskByText('Live notes popup');
  await taskPage.openTaskDetail(task);
  const popup = page.locator('[data-task-popup-dialog]');
  const notes = popup.locator('inline-markdown').first();
  await fillMarkdownEditor(notes, 'Native live notes preserved');
  await page.keyboard.press('Escape');
  await expect(popup).toBeVisible();
  await expect
    .poll(() => page.evaluate(() => document.activeElement?.tagName))
    .toBe('TASK-DETAIL-ITEM');
  await page.keyboard.press('Escape');
  await expect(popup).toHaveCount(0);
  await taskPage.openTaskDetail(task);
  await expect(popup.locator('inline-markdown')).toContainText(
    'Native live notes preserved',
  );
});

test('Tab stays inside popup and nested schedule Escape preserves parent', async ({
  page,
  workViewPage,
  taskPage,
}) => {
  await page.setViewportSize({ width: 1280, height: 900 });
  await installPopup(page);
  await workViewPage.waitForTaskList();
  await workViewPage.addTask('Nested scheduling popup');
  await taskPage.openTaskDetail(taskPage.getTaskByText('Nested scheduling popup'));
  const popup = page.locator('[data-task-popup-dialog]');
  const close = popup.getByRole('button', { name: 'Close task details', exact: true });
  await close.focus();
  for (const key of ['Tab', 'Shift+Tab', 'Tab', 'Tab', 'Shift+Tab']) {
    await page.keyboard.press(key);
    await expect
      .poll(() => popup.evaluate((el) => el.contains(document.activeElement)))
      .toBe(true);
  }
  await popup
    .locator('task-detail-item')
    .filter({ hasText: /Planned for|Schedule/ })
    .first()
    .click();
  const child = page.locator('dialog-schedule-task');
  await expect(child).toBeVisible();
  await page.keyboard.press('Escape');
  await expect(child).toHaveCount(0);
  await expect(popup).toBeVisible();
  await expect
    .poll(() => popup.evaluate((el) => el.contains(document.activeElement)))
    .toBe(true);
  await page.keyboard.press('Escape');
  await expect(popup).toHaveCount(0);
});

test('actual Kanban plugin opens the shared native popup and restores card focus', async ({
  page,
  workViewPage,
}) => {
  await page.setViewportSize({ width: 1280, height: 900 });
  await installPopup(page);
  await installZip(page, process.env.KANBAN_PLUGIN_ZIP!, 'Project Kanban');
  await page.goto('/#/project/INBOX_PROJECT/tasks');
  await workViewPage.waitForTaskList();
  await workViewPage.addTask('Real Kanban popup task');
  await page
    .locator('plugin-work-context-header-btns button')
    .filter({ has: page.locator('mat-icon', { hasText: 'view_kanban' }) })
    .click();
  const board = page.frameLocator('plugin-index iframe');
  const card = board.locator('.card').filter({ hasText: 'Real Kanban popup task' });
  await expect(card).toBeVisible();
  await card.click();
  const popup = page.locator('[data-task-popup-dialog]');
  await expect(popup.locator('task-detail-panel')).toBeVisible();
  await expect(popup).toContainText('Real Kanban popup task');
  await popup.getByRole('button', { name: 'Close task details', exact: true }).click();
  await expect(popup).toHaveCount(0);
  await expect(card).toBeFocused();
});

test('disabling removes all plugin UI and restores the original sidebar', async ({
  page,
  workViewPage,
  taskPage,
}) => {
  await page.setViewportSize({ width: 1280, height: 900 });
  await installPopup(page);
  await workViewPage.waitForTaskList();
  await workViewPage.addTask('Toggle popup task');
  await taskPage.openTaskDetail(taskPage.getTaskByText('Toggle popup task'));
  await expect(page.locator('[data-task-popup-dialog]')).toBeVisible();
  await page.locator('[data-task-popup-close]').click();
  await expect(page.locator('[data-task-popup-dialog]')).toHaveCount(0);
  await page.goto('/#/config');
  await waitForPluginManagementInit(page);
  const plugin = page
    .locator('plugin-management mat-card')
    .filter({ has: page.locator('mat-card-title', { hasText: 'Task Details Popup' }) });
  await plugin.getByRole('switch').click();
  await expect(plugin.getByRole('switch')).not.toBeChecked();
  await expect(
    page.locator(
      '[data-task-popup-style],[data-task-popup-backdrop],[data-task-popup-dialog]',
    ),
  ).toHaveCount(0);
  await expect(
    page.locator('right-panel > .content[inert],magic-side-nav[inert],app-root[inert]'),
  ).toHaveCount(0);
  await page.goto('/#/tag/TODAY/tasks');
  await workViewPage.waitForTaskList();
  const before = await page
    .locator('main-header')
    .evaluate((el) => el.getBoundingClientRect().width);
  await taskPage.openTaskDetail(taskPage.getTaskByText('Toggle popup task'));
  await expect(
    page.locator('right-panel.isOpen > .side task-detail-panel'),
  ).toBeVisible();
  await expect(page.locator('[data-task-popup-dialog]')).toHaveCount(0);
  await expect
    .poll(() =>
      page.locator('main-header').evaluate((el) => el.getBoundingClientRect().width),
    )
    .toBeLessThan(before - 200);
});

