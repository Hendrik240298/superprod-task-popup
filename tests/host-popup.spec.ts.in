});

test('popup inherits custom surface colours without a theme dependency', async ({
  page,
  workViewPage,
  taskPage,
}) => {
  await page.setViewportSize({ width: 1280, height: 900 });
  await installPopup(page);
  await page.addStyleTag({
    content:
      'body { --bg: rgb(246,234,216); --text-color: rgb(40,36,32); --separator-color: rgb(176,160,140); }',
  });
  await workViewPage.waitForTaskList();
  await workViewPage.addTask('Custom surface popup');
  await taskPage.openTaskDetail(taskPage.getTaskByText('Custom surface popup'));
  const popup = page.locator('[data-task-popup-dialog]');
  await expect(popup).toHaveCSS('background-color', 'rgb(246, 234, 216)');
  await expect(popup).toHaveCSS('color', 'rgb(40, 36, 32)');
  await expect(popup).toHaveCSS('border-top-color', 'rgb(176, 160, 140)');
});

test('responsive switch restores native mobile sheet without plugin leftovers', async ({
  page,
  workViewPage,
  taskPage,
}) => {
  await page.setViewportSize({ width: 1280, height: 900 });
  await installPopup(page);
  await workViewPage.waitForTaskList();
  await workViewPage.addTask('Responsive popup task');
  const task = taskPage.getTaskByText('Responsive popup task');
  await taskPage.openTaskDetail(task);
  await expect(page.locator('[data-task-popup-dialog]')).toBeVisible();
  await page.setViewportSize({ width: 599, height: 800 });
  await expect(
    page.locator(
      '[data-task-popup-dialog],[data-task-popup-backdrop],[data-task-popup-host]',
    ),
  ).toHaveCount(0);
  await expect(
    page.locator('mat-bottom-sheet-container task-detail-panel'),
  ).toBeVisible();
  await expect(page.locator('right-panel > .side')).toHaveCount(0);
  await page.setViewportSize({ width: 600, height: 900 });
  await expect(page.locator('mat-bottom-sheet-container')).toHaveCount(0);
  // The app owns task selection/history across breakpoints; if it cleared
  // selection, reopen via the same native button rather than mutating state.
  if (!(await page.locator('task-detail-panel').count()))
    await taskPage.openTaskDetail(task);
  await expect(page.locator('[data-task-popup-dialog]')).toBeVisible();
  await expect(page.locator('[data-task-popup-close]')).toHaveCount(1);
});

for (const viewport of [
  { width: 390, height: 844 },
  { width: 844, height: 390 },
  { width: 800, height: 1280 },
]) {
  test.describe(`native touch controls ${viewport.width}px`, () => {
    test.use({ hasTouch: true, isMobile: true });
    test('preserves native bottom sheet or popup and More actions', async ({
      page,
      workViewPage,
      taskPage,
    }) => {
      await page.setViewportSize({ width: 1024, height: 900 });
      await installPopup(page);
      await workViewPage.waitForTaskList();
      await workViewPage.addTask('Mobile popup task');
      await page.setViewportSize(viewport);
      await page.evaluate(() =>
        window.dispatchEvent(new PointerEvent('pointerdown', { pointerType: 'touch' })),
      );
      const task = taskPage.getTaskByText('Mobile popup task');
      await task.locator('.title-and-tags-wrapper').first().tap();
      await expect(page.locator('task-detail-panel')).toBeVisible();
      if (viewport.width < 600) {
        await expect(
          page.locator('mat-bottom-sheet-container task-detail-panel'),
        ).toBeVisible();
        // The native Material bottom sheet makes its own background inert.
        await expect(
          page.locator('[data-task-popup-dialog],[data-task-popup-backdrop]'),
        ).toHaveCount(0);
      } else {
        await expect(page.locator('[data-task-popup-dialog]')).toBeVisible();
      }
      const more = page.locator('task-detail-panel .task-detail-more-btn');
      if (process.env.POPUP_HOST_VERSION === '19.1.0' && viewport.width >= 600) {
        // This release itself omits More on wide touch screens. The plugin
        // preserves that native UI; it cannot manufacture the Angular menu.
        await expect(more).toHaveCount(0);
        return;
      }
      await more.tap();
      await expect(page.locator('.mat-mdc-menu-content').first()).toBeVisible();
      await page.keyboard.press('Escape');
      await expect(page.locator('task-detail-panel')).toBeVisible();
    });
  });
}

for (const colorScheme of ['light', 'dark'] as const) {
  test(`installed popup centres native List details without narrowing, ${colorScheme}`, async ({
    page,
    workViewPage,
    taskPage,
  }) => {
    await page.setViewportSize({ width: 1280, height: 900 });
    await page.emulateMedia({ colorScheme });
    await installPopup(page);
    await workViewPage.waitForTaskList();
    await workViewPage.addTask('Plugin popup task');
    const task = taskPage.getTaskByText('Plugin popup task');
    const before = await page
      .locator('main-header')
      .evaluate((el) => el.getBoundingClientRect().width);
    await taskPage.openTaskDetail(task);
    const popup = page.locator('[data-task-popup-dialog]');
    await expect(popup).toBeVisible();
    await expect(popup.locator('task-detail-panel')).toBeVisible();
    const bounds = await popup.boundingBox();
    const halfWidth = bounds!.width / 2;
    expect(Math.abs(bounds!.x + halfWidth - 640)).toBeLessThan(3);
    await expect
      .poll(() =>
        page.locator('main-header').evaluate((el) => el.getBoundingClientRect().width),
      )
      .toBeCloseTo(before, 0);
    await expect(page.locator('[data-task-popup-backdrop]')).toBeVisible();
    if (colorScheme === 'dark')
      await expect(page.locator('body')).toHaveClass(/isDarkTheme/);
    else await expect(page.locator('body')).not.toHaveClass(/isDarkTheme/);
    if (process.env.POPUP_SCREENSHOT_DIR) {
      await page.screenshot({
        path: path.join(
          process.env.POPUP_SCREENSHOT_DIR,
          `popup-${process.env.POPUP_HOST_VERSION}-${colorScheme}.png`,
        ),
      });
    }
    await popup.getByRole('button', { name: 'Close task details', exact: true }).click();

    await expect(popup).toHaveCount(0);
    await expect(page.locator('task-detail-panel')).toHaveCount(0);
  });
}
