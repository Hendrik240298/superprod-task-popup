test('fullscreen native notes save and parent popup survives child Escape', async ({
  page,
  workViewPage,
  taskPage,
}) => {
  await page.setViewportSize({ width: 1280, height: 900 });
  await installPopup(page);
  await workViewPage.waitForTaskList();
  await workViewPage.addTask('Fullscreen popup notes');
  await taskPage.openTaskDetail(taskPage.getTaskByText('Fullscreen popup notes'));
  const popup = page.locator('[data-task-popup-dialog]');
  const notes = popup.locator('inline-markdown').first();
  await notes.hover();
  await notes
    .locator('button')
    .filter({ has: page.locator('mat-icon', { hasText: 'fullscreen' }) })
    .first()
    .click();
  const child = page.locator('dialog-fullscreen-markdown');
  await expect(child).toBeVisible();
  await fillMarkdownEditor(child, 'Fullscreen native notes saved');
  await page.keyboard.press('Escape');
  await expect(child).toHaveCount(0);
  await expect(popup).toBeVisible();
  await popup.locator('[data-task-popup-close]').click();
  await taskPage.openTaskDetail(taskPage.getTaskByText('Fullscreen popup notes'));
  await expect(popup.locator('inline-markdown')).toContainText(
    'Fullscreen native notes saved',
  );
});

test('plain textarea notes save on Close and leave editing on Escape', async ({
  page,
  workViewPage,
  taskPage,
}) => {
  await page.setViewportSize({ width: 1280, height: 900 });
  await installPopup(page);
  await page.goto('/#/config?tab=1');
  const section = page.locator('.section-tasks collapsible').first();
  await section.scrollIntoViewIfNeeded();
  if (!(await section.evaluate((el) => el.classList.contains('isExpanded')))) {
    await section.locator('.collapsible-header').click();
  }
  const markdown = section
    .locator('mat-checkbox,mat-slide-toggle')
    .filter({ hasText: 'Enable Markdown formatting in task notes' })
    .first();
  await expect(markdown).toHaveClass(/checked/);
  await markdown.click();
  await expect(markdown).not.toHaveClass(/checked/);
  await page.goto('/#/tag/TODAY/tasks');
  await workViewPage.waitForTaskList();
  await workViewPage.addTask('Plain popup notes');
  const task = taskPage.getTaskByText('Plain popup notes');
  await taskPage.openTaskDetail(task);
  const popup = page.locator('[data-task-popup-dialog]');
  const notes = popup.locator('inline-markdown textarea').first();
  await notes.fill('Plain notes pending on Close');
  await popup.locator('[data-task-popup-close]').click();
  await expect(popup).toHaveCount(0);
  await taskPage.openTaskDetail(task);
  await expect(notes).toHaveValue('Plain notes pending on Close');
  await notes.focus();
  await page.keyboard.press('Escape');
  await expect(popup).toBeVisible();
  await expect
    .poll(() => page.evaluate(() => document.activeElement?.tagName))
    .toBe('TASK-DETAIL-ITEM');
  await page.keyboard.press('Escape');
  await expect(popup).toHaveCount(0);
});

